{
  "name": "omnix",
  "private": true,
  "version": "0.1.0",
  "description": "Omnix: a creative studio built for AI collaborators and the Model Context Protocol",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch packages/server/src/main.ts",
    "dev:web": "pnpm --filter @omnix/web dev",
    "build": "pnpm --filter @omnix/web build",
    "start": "tsx packages/server/src/main.ts",
    "mcp:stdio": "tsx packages/server/src/mcp/stdio.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "catalog": "tsx scripts/generate-tool-catalog.ts",
    "check": "pnpm typecheck && pnpm test",
    "bench": "tsx scripts/bench.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "zod": "^4.6.7"
  }
}
